digraph G { rankdir=LR; graph [bgcolor="white", pad="0.2", nodesep="0.4", ranksep="0.7", label="Original AI draft — sequence (visual preview)", labelloc=t, fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#444444", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#444444"]; Student -> Catalog [label="browseCatalog(semester)"]; Catalog -> Student [label="offerings + available places"]; Student -> RegistrationService [label="register(studentId, offeringId)"]; RegistrationService -> EnrollmentRepository [label="checkDuplicate"]; EnrollmentRepository -> EnrollmentStore [label="find existing enrollment"]; EnrollmentStore -> EnrollmentRepository [label="existing / none"]; RegistrationService -> EnrollmentRepository [label="checkCurrentCapacity"]; EnrollmentRepository -> EnrollmentStore [label="read count and capacity"]; EnrollmentStore -> EnrollmentRepository [label="count, capacity"]; EnrollmentRepository -> EnrollmentStore [label="save Enrollment (success only)"]; EnrollmentStore -> EnrollmentRepository [label="saved"]; RegistrationService -> Student [label="already enrolled / course full / confirm", style=dashed]; {rank=same; Catalog; RegistrationService; EnrollmentRepository; EnrollmentStore;} }