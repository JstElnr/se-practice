digraph G { graph [bgcolor="white", pad="0.2", nodesep="0.5", ranksep="0.8", label="Original AI draft — domain classes (visual preview)", labelloc=t, fontsize=18]; node [shape=record, style="filled", fillcolor="#f7f7f7", color="#444444", fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#444444"]; Student [label="{Student|studentId: String\lname: String}"]; Course [label="{Course|code: String\ltitle: String}"]; CourseOffering [label="{CourseOffering|offeringId: String\lsemester: String\lcapacity: Integer\lavailablePlaces(): Integer}"]; Enrollment [label="{Enrollment|enrollmentId: String\lcreatedAt: DateTime}"]; Student -> Enrollment [dir=none, label="1          0..*  holds"]; CourseOffering -> Enrollment [dir=none, label="1          0..*  receives"]; Course -> CourseOffering [dir=none, label="1          1..*  offered as"]; constraints [shape=note, label="Constraints\lcapacity > 0\lenrollment count <= capacity\lUnique (studentId, offeringId)"]; CourseOffering -> constraints [style=dotted, arrowhead=none]; }