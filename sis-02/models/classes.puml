@startuml
title Course registration — domain classes
class Student {
  +studentId: String
  +name: String
}
class Course {
  +code: String
  +title: String
}
class CourseOffering {
  +offeringId: String
  +semester: String
  +capacity: Integer
  +availablePlaces(): Integer
}
class Enrollment {
  +enrollmentId: String
  +createdAt: DateTime
}
Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : receives >
Course "1" -- "1..*" CourseOffering : is offered as >
note right of CourseOffering
{capacity > 0}
{enrollment count <= capacity}
availablePlaces = capacity - enrollment count
end note
note bottom of Enrollment
Unique constraint: (studentId, offeringId)
A student can enroll at most once in one offering.
end note
@enduml
